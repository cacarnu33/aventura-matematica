{
  // TypeScript revisa el JavaScript de src/js sin cambiarlo (no genera archivos).
  // Detecta, por ejemplo, funciones o variables mal escritas entre archivos.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/js/*.js", "src/types.d.ts"]
}
